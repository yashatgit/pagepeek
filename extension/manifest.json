{
  "manifest_version": 3,
  "name": "Pagecrawl cookies",
  "version": "1.0.0",
  "description": "List browser cookies, tick the ones to keep, save them to a folder and copy them to the pagecrawl service.",
  "key": "",
  "permissions": [
    "cookies",
    "downloads",
    "history",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pagecrawl cookies",
    "default_icon": {
      "16": "icons/cookie-16.png",
      "32": "icons/cookie-32.png",
      "48": "icons/cookie-48.png",
      "128": "icons/cookie-128.png"
    }
  },
  "icons": {
    "16": "icons/cookie-16.png",
    "32": "icons/cookie-32.png",
    "48": "icons/cookie-48.png",
    "128": "icons/cookie-128.png"
  }
}
