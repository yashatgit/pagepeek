# Copy to .env and fill in. .env is gitignored.

# Required. Every POST /read must send it as "Authorization: Bearer <token>".
# At least 24 characters. Make one with: openssl rand -hex 24
PAGECRAWL_TOKEN=

# Needed only for "query" mode (a question answered from screenshots by Claude Haiku).
# Locator and HTML modes work without it.
ANTHROPIC_API_KEY=

# Optional.
# PAGECRAWL_PORT=8787            port on the host (compose) or the port to listen on (npm start)
# PAGECRAWL_BIND=127.0.0.1       address to listen on for npm start; the container uses 0.0.0.0
# PAGECRAWL_MODEL=claude-haiku-5-5
# PAGECRAWL_HOST_GAP_MS=4000     minimum pause between two page loads on the same host
